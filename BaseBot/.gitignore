# ============================================================
#  .gitignore — Base 链交易机器人
# ============================================================

# ── 🔐 钱包私钥（绝对机密，泄漏即丢光！）────────────────────
wallets.json
wallets.enc
private_keys.txt
*.key
*.pem

# ── 🔑 敏感配置（API Key / Token）───────────────────────────
config.py
.env
.env.*

# ── 💾 运行时数据（账本 / 调度表 / 状态）────────────────────
data/
ledger.json
schedule.json
state.json

# ── 📝 日志文件 ──────────────────────────────────────────────
logs/
*.log

# ── 🐍 Python 缓存 ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── 📦 虚拟环境 ──────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── 🛠️ IDE / 系统 ───────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
