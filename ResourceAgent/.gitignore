# ============================================================
#  .gitignore — 开源资源自动化 Agent
# ============================================================

# ── 🔑 敏感配置（API Key / 账号密码，绝对不上传！）──────────
config.py
.env
.env.*

# ── 🍪 登录态 / Session 文件 ─────────────────────────────────
*.session
*.session-journal
data/twitter_session.json

# ── 💾 运行时数据（去重库 / 待发队列 / 计数器）──────────────
data/

# ── 📝 日志文件 ──────────────────────────────────────────────
logs/
*.log

# ── 🐍 Python 编译缓存 ───────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# ── 📦 虚拟环境 ──────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.python-version

# ── 🛠️ IDE / 编辑器配置 ──────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── 🎭 Playwright 浏览器缓存 ─────────────────────────────────
playwright-report/
test-results/
