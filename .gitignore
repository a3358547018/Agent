# ============================================================
#  .gitignore — 空投项目发掘助手
# ============================================================

# ── 🔑 敏感配置（API Key / Token，绝对不上传！）─────────────
config.py
.env
.env.*

# ── 🐍 Python 编译缓存 ───────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# ── 📦 虚拟环境 ──────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.python-version

# ── 📝 日志文件 ──────────────────────────────────────────────
logs/
*.log

# ── 🛠️ IDE / 编辑器配置 ──────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
